---
import { differenceInYears } from "date-fns";

interface Props {
  title: string;
  stats: { react: string; next: string; graphql: string; css: string };
}
const { title, stats } = Astro.props;
const now = new Date();
const years = (date: string) => differenceInYears(now, new Date(date));
---

<div class="laptop:mt-20 mt-10">
  {title && <h2 class="mb-4 text-3xl text-info">{title}</h2>}

  <div class="stats shadow w-full stats-vertical laptop:stats-horizontal bg-base-300">
    <div class="stat place-items-center">
      <p class="stat-title">React</p>
      <p class="stat-value">{years(stats.react)} years</p>
    </div>

    <div class="stat place-items-center">
      <p class="stat-title">Next.js</p>
      <p class="stat-value">{years(stats.next)} years</p>
    </div>

    <div class="stat place-items-center">
      <p class="stat-title">GraphQL</p>
      <p class="stat-value">{years(stats.graphql)} years</p>
    </div>

    <div class="stat place-items-center">
      <p class="stat-title">CSS</p>
      <p class="stat-value">{years(stats.css)} years</p>
    </div>
  </div>
</div>
