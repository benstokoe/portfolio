---
import Socials from "@/components/Socials.astro";

interface Props {
  taglineOne: string;
  taglineTwo: string;
  taglineThree: string;
  taglineFour: string;
}
const { taglineOne, taglineTwo, taglineThree, taglineFour } = Astro.props;

// Renders `*emphasised*` spans as accent-coloured text, mirroring the old
// Prismic rich-text `em` mark.
const emphasise = (text: string) =>
  text.replace(/\*(.+?)\*/g, '<span class="text-accent">$1</span>');
---

<div class="laptop:mt-20 mt-10">
  <span class="text-5xl tablet:text-6xl laptop:text-7xl laptopl:text-8xl text-bold w-4/5 mob:w-full laptop:w-4/5">
    {taglineOne}
  </span>
  <h1>
    <span
      class="text-5xl tablet:text-6xl laptop:text-7xl laptopl:text-8xl text-bold w-full laptop:w-4/5"
      set:html={emphasise(taglineTwo)}
    />
    <span
      class="text-5xl tablet:text-6xl laptop:text-7xl laptopl:text-8xl text-bold w-full"
      set:html={emphasise(taglineThree)}
    />
    <span class="text-5xl tablet:text-6xl laptop:text-7xl laptopl:text-8xl text-bold w-full">
      {taglineFour}
    </span>
  </h1>

  <Socials class="mt-6" />
</div>
