---
import { getCollection } from "astro:content";

import About from "@/components/About.astro";
import BlogPosts from "@/components/BlogPosts.astro";
import ClientLogos from "@/components/ClientLogos.astro";
import HomeHero from "@/components/HomeHero.astro";
import TechStats from "@/components/TechStats.astro";
import Work from "@/components/Work.astro";
import Layout from "@/layouts/Layout.astro";

const [homeEntry] = await getCollection("home");
const home = homeEntry.data;

const allWork = (await getCollection("work")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featuredWork = allWork.slice(0, 4);
const clientLogos = allWork.filter((project) => project.data.showInClientLogos);

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2);
---

<Layout title={home.metaTitle} description={home.metaDescription}>
  <HomeHero
    taglineOne={home.heroTaglineOne}
    taglineTwo={home.heroTaglineTwo}
    taglineThree={home.heroTaglineThree}
    taglineFour={home.heroTaglineFour}
  />

  <About title={home.aboutTitle} about={home.about} />

  <Work title={home.workTitle} work={featuredWork} />

  <BlogPosts title={home.blogTitle} posts={posts} />

  {clientLogos.length > 0 && <ClientLogos title={home.clientLogosTitle} logos={clientLogos} />}

  <TechStats title={home.techStatsTitle} stats={home.techStats} />
</Layout>
