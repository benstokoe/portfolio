---
import { getCollection, getEntry } from "astro:content";

import WorkCard from "@/components/WorkCard.astro";
import site from "@/data/site.json";
import Layout from "@/layouts/Layout.astro";

const page = await getEntry("pages", "work");
const work = (await getCollection("work")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title={`${page.data.metaTitle} | ${site.name}`} description={page.data.metaDescription}>
  <div class="mt-10 laptop:mt-20">
    <div class="laptop:mt-20 mt-10">
      <h1 class="text-3xl tablet:text-6xl laptop:text-6xl laptopl:text-8xl text-bold w-4/5 mob:w-full laptop:w-4/5 text-primary">
        {page.data.title}.
      </h1>
    </div>

    <div class="mt-10 laptop:mt-20 grid tablet:grid-cols-2 gap-8 gap-y-12">
      {
        work.map((project) => (
          <a href={`/work/${project.slug}`}>
            <WorkCard
              image={project.data.mainImage}
              name={project.data.name}
              description={project.data.description}
              technologies={project.data.technologies}
            />
          </a>
        ))
      }
    </div>
  </div>
</Layout>
